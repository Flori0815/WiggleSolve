{
  "name": "wigglesolve",
  "private": true,
  "workspaces": [
    "core-js",
    "tooling-ui",
    "test-suite/js",
    "mcp-server"
  ],
  "scripts": {
    "dev": "npm run dev -w tooling-ui",
    "build": "npm run build -w @wigglesolve/core && npm run build -w tooling-ui && npm run build -w wigglesolve-mcp-server",
    "test": "npm test -w @wigglesolve/core && npm test -w wigglesolve-integration-js",
    "test:py": "python -m pytest -q core-py/tests test-suite/py",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  }
}
